{
  "name": "bug-eating-frog",
  "displayName": "Bug-Eating Frog",
  "description": "A cozy pixel-art frog that lives in your editor and eats your bugs as you fix them.",
  "version": "0.0.1",
  "publisher": "your-publisher-id",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "pet",
    "frog",
    "pixel art",
    "companion",
    "gamification"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "frogPet.pond",
          "name": "Frog Pond"
        }
      ]
    },
    "commands": [
      {
        "command": "frogPet.showPond",
        "title": "Show Pond",
        "category": "Frog"
      },
      {
        "command": "frogPet.resetProgress",
        "title": "Reset Progress",
        "category": "Frog"
      },
      {
        "command": "frogPet.debugAddXp",
        "title": "Debug \u2014 Add 10 XP",
        "category": "Frog"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "frogPet.debugAddXp",
          "when": "frogPet.devMode"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p . && tsc -p src/webview",
    "vscode:prepublish": "npm run typecheck && node esbuild.mjs --production",
    "package": "vsce package",
    "pretest": "esbuild test/*.test.ts --bundle --platform=node --outdir=out-test --log-level=warning",
    "test": "node --test out-test/"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
