{
  "name": "froggit",
  "displayName": "Froggit",
  "description": "Froggit: a cozy pixel-art frog that lives in your editor and eats your bugs as you fix them.",
  "version": "0.1.1",
  "publisher": "yoonie-studio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YoonieBoo/froggit.git"
  },
  "bugs": {
    "url": "https://github.com/YoonieBoo/froggit/issues"
  },
  "homepage": "https://github.com/YoonieBoo/froggit#readme",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#2f5d3a",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "pet",
    "frog",
    "pixel art",
    "companion",
    "gamification"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "froggit.pond",
          "name": "Frog Pond"
        }
      ]
    },
    "commands": [
      {
        "command": "froggit.showPond",
        "title": "Show Pond",
        "category": "Froggit"
      },
      {
        "command": "froggit.resetProgress",
        "title": "Reset Progress",
        "category": "Froggit"
      },
      {
        "command": "froggit.debugAddXp",
        "title": "Debug — Add 10 XP",
        "category": "Froggit"
      },
      {
        "command": "froggit.debugWhisper",
        "title": "Debug — Whisper Now",
        "category": "Froggit"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "froggit.debugAddXp",
          "when": "froggit.devMode"
        },
        {
          "command": "froggit.debugWhisper",
          "when": "froggit.devMode"
        }
      ]
    },
    "configuration": {
      "title": "Froggit",
      "properties": {
        "froggit.countWarnings": {
          "type": "boolean",
          "default": true,
          "description": "Show warnings as small gnats in the pond and award XP for fixing them. Turn off if a linter reports many warnings you don't plan to fix."
        },
        "froggit.reducedMotion": {
          "type": "boolean",
          "default": false,
          "description": "Calmer pond: the frog stays put unless it's eating, with no confetti or water shimmer. Also turns on automatically when your operating system's 'reduce motion' setting is on."
        },
        "froggit.whispers.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Froggit Whispers: now and then, the frog says something encouraging in a little speech bubble."
        },
        "froggit.whispers.interval": {
          "type": "number",
          "enum": [
            5,
            10,
            15,
            30
          ],
          "enumItemLabels": [
            "Every 5 minutes",
            "Every 10 minutes",
            "Every 15 minutes",
            "Every 30 minutes"
          ],
          "default": 10,
          "description": "How often the frog whispers. Only time with the pond on screen counts."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p . && tsc -p src/webview",
    "vscode:prepublish": "npm run typecheck && node esbuild.mjs --production",
    "package": "vsce package",
    "pretest": "esbuild test/*.test.ts --bundle --platform=node --outdir=out-test --log-level=warning",
    "test": "node --test out-test/",
    "demo-gif": "esbuild scripts/make-demo-gif.ts --bundle --platform=node --log-level=warning | node"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
